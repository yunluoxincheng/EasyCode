{
  "productName": "EasyCode",
  "version": "0.1.6",
  "identifier": "com.easycode.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm --filter @easycode/ui run dev",
    "beforeBuildCommand": "pnpm -r run build"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/yunluoxincheng/EasyCode/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGMzkzNEQ0OUYxM0JGMkQKUldRdHZ4T2YxRFE1LzRueUE3YXAxNGUrQ2h4am4xUkN3ZFZZalhhcldQMzJyWExYckVGTDFtUFoK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "EasyCode",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0a0e0b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
