{
  "identifier": "default",
  "description": "EasyCode 主窗口能力：核心 + 窗口控制 + 对话框 + 自动更新",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "updater:default",
    "process:default",
    "opener:default"
  ]
}
